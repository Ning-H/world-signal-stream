# OpenSignal local development configuration.
# Copy to .env when a phase requires local overrides or credentials.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_UI_PORT=18080
KAFKA_TOPIC_RAW=events.raw
KAFKA_TOPIC_DLQ=events.dlq
KAFKA_TOPIC_ENRICHED=events.enriched

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=opensignal
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Wikipedia ingestion
WIKIPEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange

# GDELT ingestion
GDELT_LASTUPDATE_URL=http://data.gdeltproject.org/gdeltv2/lastupdate.txt
GDELT_POLL_INTERVAL_SECONDS=300
GDELT_STATE_DB=data/gdelt_state.sqlite3

# Hacker News ingestion, used as the Stage 1 discussion source.
HACKERNEWS_BASE_URL=https://hacker-news.firebaseio.com/v0
HACKERNEWS_LISTS=top,new,best
HACKERNEWS_LIMIT_PER_LIST=100
HACKERNEWS_POLL_INTERVAL_SECONDS=300
HACKERNEWS_STATE_DB=data/hackernews_state.sqlite3

# Reddit ingestion. Skipped for now because classic Reddit API setup is blocked.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=
REDDIT_SUBREDDITS=worldnews,news,politics,technology,science,geopolitics,AskReddit,OutOfTheLoop

# Bluesky ingestion, optional experimental social firehose.
BLUESKY_JETSTREAM_URL=wss://jetstream1.us-east.bsky.network/subscribe
BLUESKY_LANGUAGES=en

# LLM enrichment, populated at Stage 2 after provider selection.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=claude-haiku-4-5-20251001
LLM_INPUT_PRICE_PER_MTOK=0.80
LLM_OUTPUT_PRICE_PER_MTOK=4.00
LLM_BATCH_SIZE=10
LLM_CACHE_MAX_SIZE=10000
LLM_MONTHLY_BUDGET_USD=50

# Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_AUTO_REFRESH_SECONDS=5

# Deployment, populated only for approved Stage 4 work.
HETZNER_API_TOKEN=
DEPLOY_DOMAIN=
CLICKHOUSE_READONLY_USER=dashboard
CLICKHOUSE_READONLY_PASSWORD=
